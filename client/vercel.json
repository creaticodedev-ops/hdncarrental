{
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/booking-confirmation",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/complete-booking/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/owner/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/superadmin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hdncarrental-api.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://hdncarrental-api.onrender.com/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://hdncarrental-api.onrender.com/health"
    },
    {
      "source": "/((?!robots\\.txt$|sitemap\\.xml$|api/|uploads/).*)",
      "destination": "/"
    }
  ],
  "redirects": [
    { "source": "/about", "destination": "/a-propos", "permanent": true },
    { "source": "/privacy", "destination": "/confidentialite", "permanent": true },
    { "source": "/terms", "destination": "/conditions-de-location", "permanent": true },
    { "source": "/locations", "destination": "/location-voiture", "permanent": true },
    { "source": "/locations/:city", "destination": "/location-voiture/:city", "permanent": true },
    { "source": "/airport-car-rental", "destination": "/location-voiture-aeroport", "permanent": true },
    { "source": "/airport-car-rental/marrakech", "destination": "/location-voiture-aeroport/marrakech-rak", "permanent": true },
    { "source": "/airport-car-rental/casablanca", "destination": "/location-voiture-aeroport/casablanca-cmn", "permanent": true }
  ]
}
