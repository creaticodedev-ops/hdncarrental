# Copy to server/.env and fill in real values. NEVER commit real secrets.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=AppName
# Must be ≥32 characters in production (server refuses to start otherwise)
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
CLIENT_URL=https://www.example.com,https://example.com
PORT=3000
NODE_ENV=production
# TRUST_PROXY=true

# ImageKit (required for car/profile image uploads)
IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Optional agency admin seed script
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeStrongPassword!
ADMIN_NAME=Admin

# Platform Super Admin (dedicated /superadmin login — never share with agency admins)
# Seed with: npm run seed:superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=ChangeMeStrongPassword!
SUPERADMIN_NAME=Super Admin

# Trial / license
TRIAL_DAYS=7

# WhatsApp — wa.me only (no Meta/Twilio API). Prefer Admin → Settings in the dashboard.
WHATSAPP_BUSINESS_NUMBER=212600000000
WHATSAPP_CURRENCY=MAD

# Agency branding (emails / PDFs)
AGENCY_NAME=HDN Car
CURRENCY=MAD
API_PUBLIC_URL=https://api.example.com
COMPLETION_TOKEN_DAYS=7
DEPOSIT_PERCENT=30

# Email (SMTP) — REQUIRED for completion & final confirmation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=HDN Car <noreply@example.com>
# SMTP_DEBUG=true
# SMTP_ALLOW_CUSTOM_FROM=false

# Online payments — Stripe in production. Demo requires BOTH:
# PAYMENT_MODE=demo and ALLOW_DEMO_PAYMENT=true (never enable demo in production).
PAYMENT_MODE=stripe
PAYMENT_CURRENCY=mad
STRIPE_SECRET_KEY=sk_live_xxx
# ALLOW_DEMO_PAYMENT=true
# Break-glass: allow owner to force ready_for_pickup without completion (default off)
# ALLOW_FORCE_BOOKING_STATUS=true

# Puppeteer / Chrome (PDF contracts & invoices)
# On Render, Chrome must live in the project tree (see server/.puppeteerrc.cjs).
# Build must run: npm run install:chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# PUPPETEER_CACHE_DIR=/opt/render/project/src/.cache/puppeteer
# PDF_MAX_CONCURRENCY=2
# PDF_BROWSER_IDLE_MS=0
